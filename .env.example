# Penguin Overlord Discord Bot Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# OPTION 1: Direct Environment Variables (Simple Setup)
# ============================================================================
# Discord Bot Token (Required if not using secrets manager)
# Get this from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_bot_token_here

# Discord Owner ID (Your Discord User ID for admin commands)
# To get your ID: Enable Developer Mode in Discord Settings > Advanced
# Then right-click your username and select "Copy User ID"
DISCORD_OWNER_ID=your_discord_user_id_here

# ============================================================================
# OPTION 2: Doppler Secrets Manager (Recommended for Production)
# ============================================================================
# If you set DOPPLER_TOKEN, the bot will fetch secrets from Doppler
# In Doppler, add a secret named: DISCORD_BOT_TOKEN
DOPPLER_TOKEN=your_doppler_token_here
DOPPLER_PROJECT=penguin-overlord
DOPPLER_CONFIG=prd

# ============================================================================
# OPTION 3: AWS Secrets Manager
# ============================================================================
# SECRETS_MANAGER=aws
# AWS_SECRET_NAME=penguin-overlord/discord
# AWS credentials should be configured via AWS CLI or IAM role

# ============================================================================
# OPTION 4: HashiCorp Vault
# ============================================================================
# SECRETS_MANAGER=vault
# SECRETS_VAULT_URL=https://vault.example.com
# SECRETS_VAULT_TOKEN=your_vault_token_here
# VAULT_SECRET_PATH=secret/data/penguin-overlord

# ============================================================================
# General Settings
# ============================================================================
# Optional: Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ===========================================================================
# AUTO-POSTING CHANNEL CONFIGURATION (All Optional)
# ===========================================================================
# Configure channels for automatic posting features. All of these can be set
# via environment variables (.env / Doppler) OR via Discord runtime commands.
#
# Priority: Environment variables > Discord commands > Default (None)
#
# To get a channel ID:
#   1. Enable Developer Mode in Discord (Settings > Advanced)
#   2. Right-click a channel and select "Copy Channel ID"
# ===========================================================================

# ---------------------------------------------------------------------------
# 🎨 Comics & Fun
# ---------------------------------------------------------------------------
# XKCD - Automated XKCD comic posting (checks every 30 min via systemd timer)
# IMPORTANT: Must be numeric channel ID only (no # or quotes)
# Example: XKCD_POST_CHANNEL_ID=1234567890123456789
# NOTE: Set enabled=true in data/xkcd_state.json OR run !xkcd_enable after setting
XKCD_POST_CHANNEL_ID=
# XKCD_POLL_INTERVAL_MINUTES=30

# Daily Tech Comics - Posts once daily at 10:00 UTC (XKCD, Joy of Tech, TurnOff.us)
# IMPORTANT: Must be numeric channel ID only (no # or quotes)
# Example: COMIC_POST_CHANNEL_ID=1234567890123456789
# NOTE: Set enabled=true in data/comic_state.json OR run !comic_enable after setting
COMIC_POST_CHANNEL_ID=

# Runtime commands:
#   !xkcd_set_channel #channel  |  !xkcd_enable / !xkcd_disable
#   !comic_set_channel #channel |  !comic_enable / !comic_disable

# ---------------------------------------------------------------------------
# 📻 HAM Radio
# ---------------------------------------------------------------------------
# Solar/Propagation Reports - NOAA Space Weather (posts every 6 hours via systemd timer)
# IMPORTANT: Must be numeric channel ID only (no # or quotes)
# Example: SOLAR_POST_CHANNEL_ID=1234567890123456789
# NOTE: Set enabled=true in data/solar_state.json OR run !solar_enable after setting
SOLAR_POST_CHANNEL_ID=

# Runtime commands:
#   !solar_set_channel #channel | !solar_enable / !solar_disable
#   !solar_post_now             | Force post current conditions

# ---------------------------------------------------------------------------
# 📰 News & Legislation Tracking System (115 sources across 10 categories)
# ---------------------------------------------------------------------------
# Configure channel IDs for automated news and legislation tracking.
# These can also be set via Discord commands using /news set_channel
#
# Priority: Environment variables > Discord commands > Default (None)
#
# NOTE: Auto-posting is DISABLED by default for all categories.
#       Run /news enable <category> after setting channels.
#
# IMPORTANT FORMATTING: All channel IDs must be NUMERIC ONLY (no # or quotes)
# ✅ Correct:   NEWS_CYBERSECURITY_CHANNEL_ID=1234567890123456789
# ❌ Wrong:     NEWS_CYBERSECURITY_CHANNEL_ID=#security-news
# ❌ Wrong:     NEWS_CYBERSECURITY_CHANNEL_ID="1234567890123456789"
#
# All RSS feeds are PUBLIC and require NO API keys!
# All sources tested and verified working (HTTP 200 OK)
# ---------------------------------------------------------------------------

# Cybersecurity News (36 sources - every 3 hours)
# Krebs on Security, Dark Reading, Schneier on Security, Troy Hunt, Graham Cluley,
# The Hacker News, SecurityWeek, Security Affairs, Threatpost, Bleeping Computer, etc.
# IMPORTANT: Numeric channel ID only (example: 1234567890123456789)
NEWS_CYBERSECURITY_CHANNEL_ID=

# Technology News (24 sources - every 4 hours)
# Ars Technica, The Verge, TechCrunch, Wired, Engadget, ZDNet, etc.
# IMPORTANT: Numeric channel ID only
NEWS_TECH_CHANNEL_ID=

# Gaming News (15 sources - every 2 hours)
# IGN, Kotaku, PC Gamer, Polygon, Rock Paper Shotgun, Eurogamer, etc.
# IMPORTANT: Numeric channel ID only
NEWS_GAMING_CHANNEL_ID=

# Apple & Google News (18 sources - every 3 hours)
# 9to5Mac, MacRumors, AppleInsider, 9to5Google, Android Police, etc.
# IMPORTANT: Numeric channel ID only
NEWS_APPLE_GOOGLE_CHANNEL_ID=

# CVE Vulnerabilities (2 sources - every 8 hours)
# NVD Recent CVEs, Ubuntu Security Notices - General vulnerability awareness
# IMPORTANT: Numeric channel ID only
NEWS_CVE_CHANNEL_ID=

# KEV - Known Exploited Vulnerabilities (2 sources - every 4 hours)
# CISA KEV, Exploit-DB - CRITICAL/HIGH: Actively exploited vulnerabilities and available exploits
# IMPORTANT: Numeric channel ID only
NEWS_KEV_CHANNEL_ID=

# US Legislation (5 government sources - hourly updates)
# GovInfo Congressional Record, House/Senate Bills, CRS Reports, LOC Thomas
# IMPORTANT: Numeric channel ID only
NEWS_US_LEGISLATION_CHANNEL_ID=

# EU Legislation (3 sources - hourly updates)
# EUR-Lex Latest, EU Publications, EU Press Releases
# IMPORTANT: Numeric channel ID only
NEWS_EU_LEGISLATION_CHANNEL_ID=

# UK Legislation (1 source - hourly updates)
# UK Parliament All Bills (includes both public and private bills)
# IMPORTANT: Numeric channel ID only
NEWS_UK_LEGISLATION_CHANNEL_ID=

# General News (10 major outlets - every 2 hours)
# NPR, PBS, Financial Times, Pew Research, NYT, Foreign Affairs, Politico, BBC News
# IMPORTANT: Numeric channel ID only
NEWS_GENERAL_NEWS_CHANNEL_ID=

# Vendor Service Alerts (34 sources - every 30 minutes)
# Cloud: AWS, Azure, GCP, Cloudflare
# Monitoring: Zscaler (5), Datadog (7 regions)
# IAM: Okta, JumpCloud, Duo, Delinea
# DevOps: Doppler, GitHub, GitLab
# Atlassian: Jira, Confluence, Bitbucket, Trello, Opsgenie, Statuspage, Bamboo, Crowd
# Security: Wiz, Tenable
# Monitors service status pages and incident reports for critical infrastructure
# IMPORTANT: Numeric channel ID only
NEWS_VENDOR_ALERTS_CHANNEL_ID=

# Runtime alternatives:
#   /news set_channel <category> #channel
#   /news enable <category>
#   /news disable <category>
#   /news status - View current configuration
#   /news toggle_source <category> <source> - Enable/disable individual sources

# ===========================================================================
# AI / LLM CONFIGURATION (Optional)
# ===========================================================================
# Multi-provider AI system supporting Ollama and Google Gemini.
# Supports multiple Ollama servers (FrankenLLM-style) with per-feature
# model and endpoint routing.
#
# Architecture:
#   Each feature (roasting, news, cve, moderation) can use:
#   - A different Ollama server (for multi-GPU lab setups)
#   - A different model (e.g., Qwen3 for news, Llama Guard for moderation)
#   - Gemini as the primary provider or as a fallback
#
# See: https://github.com/ChiefGyk3D/FrankenLLM for multi-server setup
# ===========================================================================

# ── Global Defaults ──────────────────────────────────────────────────────
# Master enable/disable for all AI features
AI_ENABLED=true

# Default provider: 'ollama' or 'gemini'
AI_DEFAULT_PROVIDER=ollama

# Default Ollama server (used when no per-feature override is set)
# Supports legacy OLLAMA_HOST/OLLAMA_PORT format for backward compatibility
AI_DEFAULT_OLLAMA_HOST=http://localhost:11434
# OLLAMA_HOST=http://localhost
# OLLAMA_PORT=11434

# Default model (used when no per-feature override is set)
AI_DEFAULT_MODEL=gemma3:4b
# OLLAMA_MODEL=gemma3:4b  # Legacy format also supported

# ── Google Gemini Fallback ───────────────────────────────────────────────
# API key for Gemini (used as fallback when Ollama is unavailable)
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Default Gemini model for fallback
AI_GEMINI_MODEL=gemini-2.0-flash

# Enable/disable Gemini fallback globally
AI_GEMINI_FALLBACK=true

# ── Per-Feature Configuration ────────────────────────────────────────────
# Each feature can override the global defaults.
# Pattern: AI_{FEATURE}_{SETTING}
# Features: ROASTING, NEWS, CVE, MODERATION
#
# Available settings per feature:
#   _PROVIDER      - 'ollama' or 'gemini'
#   _MODEL         - Model name (e.g., qwen3:14b, gemini-2.0-flash)
#   _OLLAMA_HOST   - Full Ollama server URL (e.g., http://gpu-server:11434)
#   _GEMINI_MODEL  - Gemini model for this feature's fallback
#   _GEMINI_FALLBACK - true/false to enable Gemini fallback for this feature
#   _TEMPERATURE   - Override temperature (0.0-1.0)
#   _MAX_TOKENS    - Override max response tokens
#   _TIMEOUT       - Request timeout in seconds
#   _ENABLED       - true/false to enable/disable this specific feature

# ── Roasting (Arch Linux jokes) ─────────────────────────────────────────
# Enable AI-powered Arch Linux roasts in arch_banter cog
ARCH_BANTER_LLM=false
# AI_ROASTING_PROVIDER=ollama
# AI_ROASTING_MODEL=gemma3:12b
# AI_ROASTING_OLLAMA_HOST=http://gpu-server-1:11434
# AI_ROASTING_TEMPERATURE=0.85
# AI_ROASTING_GEMINI_MODEL=gemini-2.0-flash
# Example: Use Gemini directly for roasting
# AI_ROASTING_PROVIDER=gemini

# ── News Analysis (article summarization) ────────────────────────────────
# AI_NEWS_PROVIDER=ollama
# AI_NEWS_MODEL=qwen3:14b
# AI_NEWS_OLLAMA_HOST=http://gpu-server-2:11434
# AI_NEWS_TEMPERATURE=0.3
# AI_NEWS_MAX_TOKENS=300

# ── CVE Analysis (vulnerability assessment) ──────────────────────────────
# AI_CVE_PROVIDER=ollama
# AI_CVE_MODEL=qwen3:14b
# AI_CVE_OLLAMA_HOST=http://gpu-server-2:11434
# AI_CVE_TEMPERATURE=0.1
# AI_CVE_MAX_TOKENS=300

# ── Moderation (content analysis - future feature) ───────────────────────
# AI_MODERATION_PROVIDER=ollama
# AI_MODERATION_MODEL=llama-guard3:8b
# AI_MODERATION_OLLAMA_HOST=http://gpu-server-3:11434
# AI_MODERATION_ENABLED=false

# ── Thinking Model Support ───────────────────────────────────────────────
# For models like Qwen3 and DeepSeek-R1 that output reasoning separately.
# When enabled, the system extracts the final answer from thinking output.
# Auto-detected for known thinking models (Qwen3, DeepSeek-R1).
# AI_ENABLE_THINKING_MODE=false
# AI_THINKING_TOKEN_MULTIPLIER=4.0

# ── Queue & Rate Limiting ────────────────────────────────────────────────
# Prevents overloading when multiple features fire simultaneously
# AI_MAX_CONCURRENT_REQUESTS=4
# AI_MIN_DELAY_BETWEEN_REQUESTS=1.0

# ── Retry & Reconnection ─────────────────────────────────────────────────
# AI_MAX_RETRIES=3
# AI_RETRY_DELAY_BASE=2
# AI_ENABLE_AUTO_RECONNECT=true
# AI_RECONNECT_INTERVAL=60
# AI_MAX_RECONNECT_ATTEMPTS=0

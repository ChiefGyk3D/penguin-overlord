# requirements.txt already pins so the two locks never disagree:
#
#   uv pip compile requirements-dev.in --universal --generate-hashes --python-version 3.10 -c requirements.txt -o requirements-dev.txt
# Development and test dependencies. Runtime deps live in requirements.txt.
